# cpp-agent-runtime LLM configuration
#
# 使用方法：
#   cp .env.example .env
#   然后把下面的占位符替换成你自己的凭据。
#
# 默认指向 DeepSeek（OpenAI 兼容接口）。换回 OpenAI 只需改这三行。

OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 注意：长期记忆 / RAG 需要 provider 提供 embedding 端点。
# 若所用 provider 只有 chat 接口（如 DeepSeek），该功能会自动降级为禁用，
# agent 其余部分不受影响。详见 README §7「诚实的边界」。
